# Google OAuth 2.0 credentials
# Create a project at https://console.cloud.google.com/ and enable the Gmail API.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The full URL Google redirects to after OAuth consent
# e.g. https://yourdomain.com/api/auth/callback
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/callback

# Root URL of your deployed application (no trailing slash)
# Used to build redirect URLs after OAuth flows complete
APP_URL=https://yourdomain.com

# Google Cross-Account Protection (RISC) receiver URL
# Register this URL in Google Cloud Console under:
#   APIs & Services → Credentials → <your OAuth client> → Security > Cross-Account Protection
# See: https://developers.google.com/identity/protocols/risc
GOOGLE_SECURITY_EVENT_RECEIVER_URL=https://yourdomain.com/api/security/google-event

# Set to "production" in deployed environments to enable Secure cookies
NODE_ENV=development
